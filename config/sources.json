{
  "_meta": {
    "format": "json",
    "decision": "B0 reactivated by Council: JSON is the sole configuration format; no YAML source of truth.",
    "policy": "free-only, cache-first, rolling-hour request budgets, 2-6 second random spacing, 429 backoff 2/15/360 minutes",
    "default_geo": "SA",
    "jitter_seconds": [2, 6],
    "backoff_minutes": [2, 15, 360],
    "lang_params": { "hl": "ar", "gl": "SA", "ceid": "SA:ar" }
  },
  "site_inventory": {
    "enabled": true,
    "sitemap_url": "https://sawtalhijaz.com/sitemap.xml",
    "content_sitemap_url": "https://sawtalhijaz.com/sitemap-0.xml",
    "rate_limit_per_hour": 2,
    "requests_per_run": 2,
    "cache_ttl_seconds": 21600,
    "timeout_ms": 15000,
    "jitter_seconds": [2, 6],
    "notes": "جرد خريطة الموقع العامة فقط؛ طلبان كحد أقصى/ساعة، cache-first لمدة 6 ساعات."
  },
  "sources": {
    "trends-rss": {
      "type": "rss",
      "url": "https://trends.google.com/trending/rss?geo=SA",
      "enabled": true,
      "weight": 1.0,
      "rate_limit_per_hour": 2,
      "cache_ttl_seconds": 1800,
      "max_items": 5,
      "timeout_ms": 20000,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "RSS العام من Google Trends للسعودية"
    },
    "gnews": {
      "type": "rss",
      "url": "https://news.google.com/rss/search",
      "enabled": true,
      "weight": 0.9,
      "rate_limit_per_hour": 6,
      "cache_ttl_seconds": 600,
      "max_items": 5,
      "timeout_ms": 20000,
      "params": { "hl": "ar", "gl": "SA", "ceid": "SA:ar" },
      "general_query": "when:1h",
      "desk_queries": {
        "قرارات-أحداث": { "label": "قرار مجلس الوزراء", "query": "قرار مجلس الوزراء" },
        "تريند-الشارع": { "label": "تريند", "query": "تريند" },
        "روشن-الرياضية": { "label": "روشن رياضية", "query": "روشن رياضية" }
      },
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "GNews: when:1h عام + استعلام لكل قسم من desks"
    },
    "telegram": {
      "type": "html-preview",
      "url_template": "https://t.me/s/{channel}",
      "enabled": true,
      "weight": 0.6,
      "channels": ["SabqOrg", "SaudiNews50", "AjelNews"],
      "rate_limit_per_hour": 4,
      "cache_ttl_seconds": 900,
      "max_items": 5,
      "timeout_ms": 20000,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "ثلاث قنوات سعودية عامة عبر HTML preview"
    },
    "wiki-top": {
      "type": "json-api",
      "url_template": "https://wikimedia.org/api/rest_v1/metrics/pageviews/top/ar.wikipedia.org/all-access/{date}",
      "enabled": true,
      "weight": 0.4,
      "rate_limit_per_hour": 2,
      "cache_ttl_seconds": 21600,
      "max_items": 5,
      "timeout_ms": 20000,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "مشاهدات ويكيبيديا العربية لليوم السابق"
    },
    "wiki-rc": {
      "type": "json-api",
      "url": "https://ar.wikipedia.org/w/api.php",
      "enabled": true,
      "weight": 0.4,
      "params": {
        "action": "query",
        "list": "recentchanges",
        "rclimit": "50",
        "format": "json",
        "rcprop": "title|timestamp|user|comment|flags|ids"
      },
      "rate_limit_per_hour": 2,
      "cache_ttl_seconds": 1800,
      "max_items": 5,
      "timeout_ms": 20000,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "recentchanges من واجهة ويكيبيديا العربية"
    },
    "wayback-cdx": {
      "type": "cdx",
      "url": "https://web.archive.org/cdx/search/cdx",
      "enabled": true,
      "daily_enabled": false,
      "run_mode": "weekly",
      "weight": 0.5,
      "domains": ["spa.gov.sa"],
      "match_type": "domain",
      "weekly_limit": 5,
      "rate_limit_per_hour": 1,
      "cache_ttl_seconds": 604800,
      "max_items": 5,
      "timeout_ms": 25000,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "تقارير أسبوعية فقط؛ معطل في الرادار اليومي"
    },
    "gdelt-files": {
      "type": "zip-csv",
      "lastupdate_url": "https://data.gdeltproject.org/gdeltv2/lastupdate.txt",
      "enabled": true,
      "weight": 0.7,
      "rate_limit_per_hour": 2,
      "cache_ttl_seconds": 1800,
      "max_items": 5,
      "max_export_files_per_run": 1,
      "max_uncompressed_bytes": 50000000,
      "timeout_ms": 30000,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "lastupdate.txt ثم ملف export.CSV.zip الأحدث وحده، مع فلترة الصفوف العربية"
    },
    "bing-dorks": {
      "type": "html-search",
      "url": "https://www.bing.com/search",
      "enabled": true,
      "weight": 0.5,
      "rate_limit_per_hour": 6,
      "cache_ttl_seconds": 600,
      "max_items": 10,
      "timeout_ms": 20000,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "دوركس البحث الأولية من config/dorks-init.json؛ سقف عشرة نتائج"
    },
    "bridge": {
      "type": "rss-bridge",
      "url": "https://rss-bridge.org/bridge01/",
      "enabled": false,
      "approval_required": true,
      "weight": 0.3,
      "rate_limit_per_hour": 1,
      "cache_ttl_seconds": 21600,
      "max_items": 5,
      "timeout_ms": 20000,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "معطل؛ لا يفعّل إلا باعتماد مجلس موثق"
    },
    "gdelt-doc": {
      "type": "api",
      "url": "https://api.gdeltproject.org/api/v2/doc/doc",
      "enabled": false,
      "weight": 0.6,
      "rate_limit_per_hour": 0,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "مشروط — يعطي 429 عند الاستخدام المكثف؛ يفعّل بقرار المجلس"
    },
    "rsshub": {
      "type": "rss",
      "url": "https://rsshub.app/...",
      "enabled": false,
      "weight": 0.0,
      "rate_limit_per_hour": 0,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "مستبعد حالياً — 403 في البيئة"
    },
    "searxng": {
      "type": "scrape",
      "url": "https://searxng.site/...",
      "enabled": false,
      "weight": 0.0,
      "rate_limit_per_hour": 0,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "مستبعد حالياً — بلا JSON في الاستجابة"
    },
    "reddit": {
      "type": "scrape",
      "url": "https://www.reddit.com/r/{sub}/.rss",
      "enabled": false,
      "weight": 0.0,
      "rate_limit_per_hour": 0,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "مستبعد حالياً — 403"
    }
  }
}
