{
  "_meta": {
    "format": "json (بديل عن YAML لعدم توفر parser بلا تبعيات — قرار B0 موثّق في التقرير)",
    "policy": "free-only، cache-first، backoff أُسّي 2/15/360 د، فاصل عشوائي 2–6ث",
    "default_geo": "SA",
    "lang_params": { "hl": "ar", "gl": "SA", "ceid": "SA:ar" }
  },
  "sources": {
    "trends-rss": {
      "type": "rss",
      "url": "https://trends.google.com/trending/rss?geo=SA",
      "enabled": true,
      "weight": 1.0,
      "rate_limit_per_hour": 2,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "RSS العام من قوقل ترندز للسعودية"
    },
    "gnews-1h": {
      "type": "rss",
      "url": "https://news.google.com/rss/search?q=when:1h&hl=ar&gl=SA&ceid=SA:ar",
      "enabled": true,
      "weight": 0.9,
      "rate_limit_per_hour": 6,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "عائلة GNews — نافذة آخر ساعة (مصدر فرع مفعّل)"
    },
    "gnews-desk": {
      "type": "rss",
      "url": "https://news.google.com/rss/search?q={query}&hl=ar&gl=SA&ceid=SA:ar",
