      "weight": 0.9,
      "rate_limit_per_hour": 6,
      "backoff_minutes": [2, 15, 360],
      "jitter_seconds": [2, 6],
      "cache_first": true,
      "notes": "عائلة GNews — بحث بالمكتب/الزاوية (مصدر فرع مفعّل)"
    },
    "telegram": {
      "type": "scrape",
